{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LiveKeyboard",
  "version": "0.1.0",
  "identifier": "com.mengdoo.live-keyboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Live Keyboard",
        "width": 450,
        "height": 700,
        "minWidth": 450,
        "minHeight": 700,
        "maxWidth": 450,
        "maxHeight": 700,
        "resizable": false,
        "decorations": true,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../public/voices"
    ]
  }
}
